services:
  hanfor:
    build: .
    ports: ["5000:5000"]
    # set the tag if you want to run multiple sessions
    environment:
      HANFOR_TAG: awesome_tag
    volumes:
      - ./volumes/data:/app/data
      - ./example_input:/input:ro
      - ./hanfor/config.py:/app/config.py:ro
      - ./hanfor/configuration/ai_config.py:/app/configuration/ai_config.py:ro
      - ./hanfor/configuration/threading_config.py:/app/configuration/threading_config.py:ro
      - ./hanfor/configuration/ultimate_config.py:/app/configuration/ultimate_config.py:ro
